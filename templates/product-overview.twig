<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>'t Zwolse kunsthuis</title>
    <link rel="stylesheet" href="{{ siteUrl('assets/app.css') }}">
</head>
<body>
    {% include 'UI-elements/nav-bar.twig' %}
    <main class="mt-24">
        <header class="mx-4 border-b-4 border-black pb-6 md:mx-8 md:pb-8">
            <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
                <h1 class="m-0 text-[clamp(3rem,8vw,7rem)] leading-[0.9]">Shop</h1>
            </div>
        </header>

        <section class="mx-4 py-6 md:mx-8 md:py-8" aria-label="Producten">
            <div class="mb-6 border-b border-black pb-3">
                <h2 class="m-0 text-xl">Alle werken</h2>
            </div>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                <a href="{{ siteUrl('product') }}" class="group flex flex-col text-inherit">
                    <div class="relative aspect-[4/3] overflow-hidden border-4 border-black">
                        <img src="{{ siteUrl('assets/placeholder_image.jpg') }}" alt="Een feest waarbij velen sterven" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105">
                    </div>
                    <div class="flex flex-1 flex-col gap-3 border-x-4 border-b-4 border-black p-4 transition-colors group-hover:bg-black group-hover:text-white">
                        <div>
                            <h2 class="mb-1 text-xl">Een feest waarbij velen sterven</h2>
                            <p class="mb-0">Gideon Eilert</p>
                        </div>
                        <div class="mt-auto flex justify-between gap-4 border-t border-current pt-3 text-sm">
                            <span>16 juni t/m 23 juli</span>
                            <span class="font-semibold uppercase">Bekijk</span>
                        </div>
                    </div>
                </a>
            </div>
        </section>
    </main>
    {% include 'UI-elements/footer.twig' %}
    <script src="{{ siteUrl('assets/nav-bar.js') }}"></script>
</body>
</html>
